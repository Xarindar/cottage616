{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	log {
		format json
	}
	respond /health 200
	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}
	root * .
	map {path} {asset_redirect} {
		default ""
__ASSET_REDIRECTS__
	}
	@retired expression `{asset_redirect} != ""`
	redir @retired "{asset_redirect}?{query}" 308
	file_server {
		hide .git .env* .tmp .impeccable
	}
	encode gzip zstd
	try_files {path} {path}.html {path}/index.html
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
